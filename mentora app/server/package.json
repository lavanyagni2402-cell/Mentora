{
  "name": "mentora-server",
  "version": "1.0.0",
  "description": "Mentora API (Node.js, Express, PostgreSQL)",
  "main": "src/index.js",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "seed": "node --env-file=.env src/db/seed-demo.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": { "node": ">=20.6" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
